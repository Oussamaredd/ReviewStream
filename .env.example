KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=reviews
SPARK_KAFKA_FAIL_ON_DATA_LOSS=false

HDFS_BASE_PATH=hdfs://localhost:9000/reviewstream
HDFS_DEFAULT_FS=hdfs://localhost:9000
HDFS_CLIENT_USE_DATANODE_HOSTNAME=true
AMAZON_REVIEWS_CSV=data/Reviews.csv
SPARK_SQL_SHUFFLE_PARTITIONS=1
SPARK_STREAM_TRIGGER_SECONDS=30

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
API_HOST=0.0.0.0
API_PORT=8000

HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_DATABASE=reviewstream
HIVE_USERNAME=root
HIVE_AUTH=NOSASL
HIVE_SOCKET_TIMEOUT_SECONDS=30
DASHBOARD_BACKGROUND_REFRESH_ENABLED=false
